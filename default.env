# The settings are in .env, use "nano .env". Don't edit default.env itself.
COMPOSE_FILE=sui.yml
EXTRAS=

NETWORK=mainnet
DOCKER_TAG=mainnet-v1.46.3
RPC_PORT=9000
P2P_PORT=8084

# Restore from a specific epoch's formal snapshot instead of the latest. A snapshot for
# epoch N restores state as of the *end* of N, so the node starts at the first
# checkpoint of N+1 - pick N-1 if you need to retain history from within epoch N.
# Only applies on first initialisation.
SNAPSHOT_EPOCH=

# Snapshot restore tuning. The restore verifies against checkpoints.mainnet.sui.io, and
# at 50 parallel downloads those requests can time out and abort the whole restore -
# which then starts over from scratch. Lower this if you see "operation timed out".
SNAPSHOT_PARALLEL_DOWNLOADS=50
SNAPSHOT_MAX_RETRIES=3

# Pruning window. Sui prunes transactions and events, not just state, so this is how far
# back the node can serve history.
NUM_EPOCHS_TO_RETAIN=0
NUM_EPOCHS_TO_RETAIN_FOR_CHECKPOINTS=2

# gRPC v2 API. enable-indexing serves gRPC on RPC_PORT, enable-index-processing keeps
# JSON-RPC working alongside it. The gRPC index only builds forward from wherever the
# node is when first enabled, so set these before the initial snapshot restore if
# historical checkpoints need serving over gRPC.
RPC_ENABLE_INDEXING=false
RPC_ENABLE_INDEX_PROCESSING=false

# Archival fallback, used by state sync when the node falls behind what peers retain.
# The mainnet bucket is requester-pays, so credentials are required and egress is billed
# to that account.
#
# Credentials are given as PATHS to files holding the value, not the value itself -
# sui-node reads the file content. Keep them out of this file: .env is world-readable
# by default and is also visible via `docker inspect`. Create the files yourself, 0400
# and owned by the container user (uid 10001), somewhere under the data volume.
# ARCHIVE_INGESTION_URL=https://s3.us-west-2.amazonaws.com/mysten-mainnet-checkpoints
ARCHIVE_INGESTION_URL=
ARCHIVE_CONCURRENCY=5
ARCHIVE_AWS_KEY_FILE=
ARCHIVE_AWS_SECRET_FILE=
AWS_REQUEST_PAYER=true

# Secure web proxy for the gRPC API - see grpc.yml, add it to COMPOSE_FILE to enable.
GRPC_HOST=sui-grpc-a
GRPC_TOKEN=

# Auto-upgrade container settings (auto-upgrade.yml)
WATCH_INTERVAL=86400
RUN_ONCE=0
SERVICE_NAME=sui-node
## Slack notifications
## - Set SLACK_WEBHOOK_URL to enable notifications.
## - Set SLACK_NO_UPDATE=1 to send a message when no upgrade is needed.
SLACK_WEBHOOK_URL=
SLACK_NO_UPDATE=0

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=sui-a
RPC_LB=sui-lb

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# Set a Github tag here to pin the script to a version.
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=1
